__pycache__/
*.pyc
.venv*/

# eval: built by utils/eval/benchmarks.py, rebuilt in seconds, never committed
vendor/
raw/
questions/
runs/

# training data: rebuilt by utils/train/prepare_data.py; it would otherwise ride
# along in the `git bundle --all` the submission asks for
data/

outputs/
*.log

# sampled training traces: rebuilt by sample_traces.py
samples/

# run_queue.sh state
queue/*.done
queue/*.failed

# trained LoRA adapters: large; the submitted one is sent separately as .safetensors
adapters/

# local secrets and IDE state
.env
.idea/
